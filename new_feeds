class xTBRepulsive(Feed):
    """

    """

    def __init__(
            self, coefficients: Parameter):

        super().__init__()
        self.coefficients = coefficients

    def forward(self, distances: Tensor) -> Tensor:
        """Evaluate the repulsive interaction at the specified distance(s).

        Arguments:
            distances: Distance(s) at which the repulsive term is to be
                evaluated.

        Returns:
            repulsive: Repulsive interaction energy as evaluated at the
                specified distances.
        """
        results = torch.zeros_like(distances)
        c = self.coefficients
        z1 = c[0]
        z2 = c[1]
        a1 = c[2]
        a2 = c[3]
        kf = 1.5

        results = z1 * z2 / distances * torch.exp(-torch.sqrt(a1 * a2) * distances**kf)

        return results
    
def build_coefficient(Atom_num_1, Atom_num_2, alpha_values):
    list = [Parameter(Tensor([Atom_num_1]), requires_grad = True), 
            Parameter(Tensor([Atom_num_2]), requires_grad = True), 
            alpha_values[Atom_num_1],
            alpha_values[Atom_num_2]]
    return list


